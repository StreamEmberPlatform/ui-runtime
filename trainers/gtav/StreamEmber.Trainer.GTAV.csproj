<Project Sdk="Microsoft.NET.Sdk">

  <!-- StreamEmber Trainer (GTA V): StreamEmber Runtime script that drives the MHud UI through the StreamEmber overlay.
       Installed into <game>\StreamEmber\Scripts together with StreamEmber.Overlay.Bridge.dll (build.ps1). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>StreamEmber.Trainer.GTAV</AssemblyName>
    <RootNamespace>StreamEmber.Trainers</RootNamespace>
    <Product>StreamEmber Trainer (GTA V)</Product>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <!-- Compile-time reference only; the game loads StreamEmber.Scripting.GTAV.dll from StreamEmber\Runtime.
         build.ps1 passes the released (CI) or sibling-built (local) file; default: ..\gtav-runtime-scripthook build. -->
    <ScriptingReference Condition="'$(ScriptingReference)' == ''">$(MSBuildThisFileDirectory)..\..\..\gtav-runtime-scripthook\bin\Release\StreamEmber.Scripting.GTAV.dll</ScriptingReference>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="StreamEmber.Scripting.GTAV">
      <HintPath>$(ScriptingReference)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <ProjectReference Include="..\..\bridge\StreamEmber.Overlay.Bridge\StreamEmber.Overlay.Bridge.csproj" />
    <!-- Game independent trainer parts (JSON, MHud messages, menus, world tag engine), shared with trainers\rdr2 -->
    <Compile Include="..\common\*.cs" Link="Common\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CheckScriptingReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ScriptingReference)')"
           Text="StreamEmber.Scripting.GTAV.dll not found: $(ScriptingReference). Build gtav-runtime-scripthook or pass -p:ScriptingReference=..." />
  </Target>

</Project>
