<Project Sdk="Microsoft.NET.Sdk">

  <!-- StreamEmber Trainer Demo: SHVDN v3 script that drives an MHud UI through the StreamEmber overlay.
       Output goes to the game's scripts folder together with StreamEmber.Overlay.Bridge.dll (build.ps1 does it). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>StreamEmber.TrainerDemo</AssemblyName>
    <RootNamespace>StreamEmber.TrainerDemo</RootNamespace>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <Version>0.1.0</Version>
    <!-- Compile-time reference only; the game provides ScriptHookVDotNet3.dll at runtime.
         It MUST be the same build as the one in the game: prefer our fork's output (GTAVScriptHookRuntime).
         A different nightly fails at runtime with MissingMethodException (e.g. GTA.FeedPost vs GTA.UI.FeedPost). -->
    <ShvdnRuntimeDll>$(MSBuildThisFileDirectory)..\..\..\..\GTAVScriptHookRuntime\bin\Release\ScriptHookVDotNet3.dll</ShvdnRuntimeDll>
    <ShvdnReferencePath Condition="'$(ShvdnReferencePath)' == '' And Exists('$(ShvdnRuntimeDll)')">$(ShvdnRuntimeDll)</ShvdnReferencePath>
    <ShvdnReferencePath Condition="'$(ShvdnReferencePath)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\GTAVScriptHook\lib\ScriptHookVDotNet3.dll</ShvdnReferencePath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>$(ShvdnReferencePath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <ProjectReference Include="..\..\..\bridge\StreamEmber.Overlay.Bridge\StreamEmber.Overlay.Bridge.csproj" />
    <!-- Game independent trainer parts (JSON, MHud messages, menus, world tag engine), shared with samples\rdr2 -->
    <Compile Include="..\..\common\*.cs" Link="Common\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
