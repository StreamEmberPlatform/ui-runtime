<Project Sdk="Microsoft.NET.Sdk">

  <!-- StreamEmber Trainer Demo (RDR2): ScriptHookRDR2DotNet script that drives an MHud UI through the StreamEmber
       overlay. Same page and shared code as samples\gtav; output goes to the game's scripts folder together with
       StreamEmber.Overlay.Bridge.dll (build.ps1 does it). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>StreamEmber.Rdr2TrainerDemo</AssemblyName>
    <RootNamespace>StreamEmber.TrainerDemo</RootNamespace>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <Version>0.1.0</Version>
    <!-- Compile-time reference only; the game provides ScriptHookRDRNetAPI.dll at runtime. It must be the build
         installed in the game: our fork's output (..\RDR2ScriptHookRuntime, built with its build.ps1). -->
    <RdrApiReferencePath Condition="'$(RdrApiReferencePath)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\RDR2ScriptHookRuntime\bin\Release\ScriptHookRDRNetAPI.dll</RdrApiReferencePath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ScriptHookRDRNetAPI">
      <HintPath>$(RdrApiReferencePath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <ProjectReference Include="..\..\..\bridge\StreamEmber.Overlay.Bridge\StreamEmber.Overlay.Bridge.csproj" />
    <!-- Game independent trainer parts (JSON, MHud messages, menus, world tag engine), shared with samples\gtav -->
    <Compile Include="..\..\common\*.cs" Link="Common\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
