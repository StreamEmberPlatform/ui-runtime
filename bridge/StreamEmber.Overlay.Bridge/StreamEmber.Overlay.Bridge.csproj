<Project Sdk="Microsoft.NET.Sdk">

  <!-- Game independent C# bridge to StreamEmber.Overlay.dll, used by the StreamEmber Runtime scripts of every game.
       Installed into <game>\StreamEmber\Scripts. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>StreamEmber.Overlay.Bridge</AssemblyName>
    <RootNamespace>StreamEmber.Overlay</RootNamespace>
    <Product>StreamEmber Overlay Bridge</Product>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <EmbeddedResource Include="Surface.html" LogicalName="StreamEmber.Surface.html" />
  </ItemGroup>
</Project>
